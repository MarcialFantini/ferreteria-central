---
import { MAP_HEIGHT, MAP_WIDTH, PROVINCE_SHAPES } from '../data/argentina-map';
import { DEFAULT_FILTERS, provinceData } from '../data/selectors';
import { provinceOpacity, topProvinces } from '../render/map';
import { formatCompact, formatMoney, formatPercent } from '../lib/format';

const rows = provinceData(DEFAULT_FILTERS);
const opacity = provinceOpacity(rows);
const top = topProvinces(rows, 6);
const sorted = [...rows].sort((a, b) => b.revenue - a.revenue);
const maxShare = top[0]?.share ?? 1;
const labelled = new Set(top.slice(0, 1).map((p) => p.id));
---

<section class="scene scene-map" id="escena-2" data-scene="map" aria-labelledby="map-title">
  <header class="scene-head">
    <span class="scene-index" aria-hidden="true">02</span>
    <h2 class="scene-title" id="map-title">Dónde se vende</h2>
    <p class="scene-sub">Cada provincia se enciende según su facturación. Los pedidos caen sobre las ciudades. Elegí una provincia para ver sus clientes.</p>
  </header>

  <div class="scene-body map-layout">
    <figure class="map-figure" data-map-figure>
      <svg
        class="map-svg"
        viewBox={`0 0 ${MAP_WIDTH} ${MAP_HEIGHT}`}
        data-map-svg
        data-base-viewbox={`0 0 ${MAP_WIDTH} ${MAP_HEIGHT}`}
        role="img"
        aria-label="Mapa de Argentina coloreado por facturación provincial"
      >
        <g data-provinces>
          {
            PROVINCE_SHAPES.map((p) => (
              <path d={p.d} data-province={p.id} class="province" fill-opacity={opacity.get(p.id) ?? 0.07} />
            ))
          }
        </g>
        <g data-rain class="rain"></g>
        <g data-live-layer class="live-layer"></g>
        <g data-clients class="client-dots"></g>
        <g data-labels class="map-labels" aria-hidden="true">
          {
            PROVINCE_SHAPES.filter((p) => labelled.has(p.id)).map((p) => {
              const row = rows.find((r) => r.id === p.id);
              return (
                <g transform={`translate(${p.cx} ${p.cy})`} data-label={p.id}>
                  <text class="map-label-name" x="0" y="-8" text-anchor="middle">
                    {p.name}
                  </text>
                  <text class="map-label-value" x="0" y="32" text-anchor="middle">
                    {formatCompact(row?.revenue ?? 0)}
                  </text>
                </g>
              );
            })
          }
        </g>
      </svg>
      <figcaption class="map-caption">Límites: IGN vía geoBoundaries (CC BY 3.0 IGO).</figcaption>
    </figure>

    <div class="map-panel">
      <div class="panel-country" data-panel-country>
        <p class="eyebrow">Ranking por provincia · <span data-map-period>Mes</span></p>
        <ol class="prov-rank" data-prov-rank>
          {
            top.map((p, i) => (
              <li>
                <button type="button" class="prov-btn" data-drill={p.id}>
                  <span class="prov-pos num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="prov-name">{p.name}</span>
                  <span class="prov-value num">{formatCompact(p.revenue)}</span>
                  <span class="prov-bar" aria-hidden="true">
                    <span style={`transform:scaleX(${(p.share / maxShare).toFixed(3)})`} />
                  </span>
                </button>
              </li>
            ))
          }
        </ol>
        <label class="prov-select">
          <span>Ver clientes de</span>
          <select data-drill-select>
            <option value="">Elegí una provincia…</option>
            {[...rows].sort((a, b) => a.name.localeCompare(b.name, 'es')).map((p) => <option value={p.id}>{p.name}</option>)}
          </select>
        </label>
      </div>

      <div class="panel-drill" data-panel-drill hidden>
        <button type="button" class="btn" data-drill-back><span aria-hidden="true">←</span> Volver al país</button>
        <p class="eyebrow drill-kicker">Clientes en</p>
        <h3 class="drill-title" data-drill-title tabindex="-1"></h3>
        <p class="drill-total num" data-drill-total></p>
        <ol class="client-list" data-client-list></ol>
      </div>
    </div>
  </div>

  <details class="data-alt">
    <summary>Ver datos en tabla</summary>
    <div class="table-wrap">
      <table class="data-table" data-map-table>
        <caption>Facturación por provincia en el período seleccionado</caption>
        <thead><tr><th scope="col">Provincia</th><th scope="col">Facturación</th><th scope="col">Participación</th><th scope="col">Clientes activos</th></tr></thead>
        <tbody>
          {
            sorted.map((r) => (
              <tr>
                <th scope="row">{r.name}</th>
                <td>{formatMoney(r.revenue)}</td>
                <td>{formatPercent(r.share)}</td>
                <td>{r.clients}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>
</section>

<style>
  .map-layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: center;
  }

  .map-figure {
    margin: 0;
    position: relative;
    height: min(68svh, 780px);
    min-height: 420px;
  }

  .map-svg {
    width: 100%;
    height: 100%;
    display: block;
    touch-action: manipulation;
  }

  .map-svg :global(.province) {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 0.8;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    cursor: pointer;
    transition: stroke 0.15s;
  }

  .map-svg :global(.province:hover),
  .map-svg :global(.province.is-active) {
    stroke: var(--ink);
    stroke-width: 1.4;
  }

  .map-svg :global(.province-base) {
    fill: var(--map-base);
    stroke: var(--bg);
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
  }

  .map-svg :global(.rain circle) {
    fill: var(--ink);
  }

  .map-svg :global(.client-dots circle) {
    fill: var(--bg);
    fill-opacity: 0.88;
    stroke: var(--ink);
    cursor: pointer;
  }

  .map-svg :global(.client-dots circle:hover) {
    fill: var(--ink);
  }

  .map-labels :global(text) {
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
    stroke-linejoin: round;
    pointer-events: none;
  }

  .map-labels :global(.map-label-name) {
    font: 600 18px var(--font-text);
  }

  .map-labels :global(.map-label-value) {
    font: 700 40px var(--font-display);
  }

  .map-caption {
    position: absolute;
    bottom: -4px;
    left: 0;
    font-size: 12px;
    color: var(--muted);
  }

  .prov-rank {
    list-style: none;
    margin: 12px 0 24px;
    padding: 0;
  }

  .prov-btn {
    width: 100%;
    display: grid;
    grid-template-columns: 44px 1fr auto;
    grid-template-rows: auto 6px;
    align-items: baseline;
    gap: 2px 12px;
    padding: 10px 0 12px;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    text-align: left;
    cursor: pointer;
  }

  .prov-btn:hover .prov-name {
    color: var(--accent);
  }

  .prov-pos {
    color: var(--muted);
    font-size: 20px;
    font-weight: 600;
  }

  .prov-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1;
    transition: color 0.2s;
  }

  .prov-value {
    font-weight: 700;
    font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1;
  }

  .prov-bar {
    grid-column: 2 / -1;
    height: 4px;
    background: var(--line);
    overflow: hidden;
  }

  .prov-bar span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
  }

  .prov-select {
    display: grid;
    gap: 6px;
    color: var(--muted);
    font-size: 14px;
  }

  .prov-select select {
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    max-width: 320px;
  }

  .drill-kicker {
    margin-top: 24px;
  }

  .drill-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(40px, 5vw, 72px);
    line-height: 0.95;
  }

  .drill-title:focus {
    outline: none;
  }

  .drill-total {
    font-size: 26px;
    font-weight: 700;
    color: var(--accent);
    margin: 4px 0 16px;
  }

  .client-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-height: 46svh;
    overflow-y: auto;
  }

  .client-list :global(li) {
    display: grid;
    grid-template-columns: 1fr auto 96px;
    gap: 12px;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }

  .client-list :global(.c-name) {
    font-weight: 500;
    line-height: 1.2;
  }

  .client-list :global(.c-city) {
    display: block;
    color: var(--muted);
    font-size: 13px;
  }

  .client-list :global(.c-value) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    font-variant-numeric: tabular-nums;
  }

  .client-list :global(.mini-spark) {
    width: 96px;
    height: 28px;
    color: var(--accent);
  }

  @media (max-width: 480px) {
    .client-list :global(li) {
      grid-template-columns: 1fr auto 56px;
      gap: 8px;
    }

    .client-list :global(.mini-spark) {
      width: 56px;
    }
  }

  @media (max-width: 860px) {
    .map-layout {
      grid-template-columns: 1fr;
    }

    .map-figure {
      height: 68svh;
      min-height: 0;
    }
  }
</style>
