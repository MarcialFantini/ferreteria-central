---
/**
 * Header estático del dashboard.
 *
 * Muestra la marca "Ferretería Central", el título del dashboard y un
 * "placeholder" textual del selector de período. El selector interactivo
 * vive dentro del componente Dashboard (T10.11 + T10.12) para mantener
 * todo el estado del filtro en una sola isla React.
 */
---

<header class="border-b border-[var(--color-line)] bg-[var(--color-panel)]">
  <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-5 sm:px-6 sm:py-6 md:flex-row md:items-center md:justify-between lg:px-8">
    <a href="/" class="flex items-center gap-3 no-underline">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-md bg-[var(--color-accent)]/10 text-[var(--color-accent)] ring-1 ring-inset ring-[var(--color-accent)]/20"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
          <path d="M14.7 6.3a4.5 4.5 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4.5 4.5 0 0 0 5.4-5.4l-2.4 2.4-2.6-2.6 2.4-2.4z" />
        </svg>
      </span>
      <span class="flex flex-col leading-tight">
        <span class="text-base font-semibold tracking-tight text-[var(--color-ink)] sm:text-lg">
          Ferretería Central
        </span>
        <span class="text-xs text-[var(--color-ink-2)]">
          Panel interno · Demo con datos simulados
        </span>
      </span>
    </a>

    <div class="flex items-center gap-2 md:gap-3">
      <span class="sr-only">Período del reporte:</span>
      <span
        id="periodo-placeholder"
        class="inline-flex items-center gap-2 rounded-md border border-dashed border-[var(--color-line)] bg-[var(--color-surface)] px-2.5 py-1.5 text-[11px] uppercase tracking-wider text-[var(--color-ink-3)] tabular"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <path d="M16 2v4M8 2v4M3 10h18" />
        </svg>
        Selector debajo
      </span>
    </div>
  </div>
</header>