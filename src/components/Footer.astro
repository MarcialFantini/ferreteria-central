---
/**
 * Footer estático del dashboard.
 *
 * Muestra un disclaimer prominente de que los datos son simulados.
 * Sin año dinámico — el footer es estable para evitar hidration mismatch
 * entre SSR y client.
 */

const anioActual = new Date().getFullYear();
---

<footer class="mt-12 border-t border-dash-line bg-dash-panel">
  <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-5 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
    <div class="flex flex-col gap-1">
      <p class="text-sm font-semibold tracking-tight text-dash-ink">
        Ferretería Central <span class="text-dash-ink-3">·</span> Dashboard de ventas
      </p>
      <p class="text-xs text-dash-ink-2">
        Demo con datos simulados. No representa información comercial real.
      </p>
    </div>
    <p class="text-xs text-dash-ink-3 tabular">
      © {anioActual} <span class="text-dash-line">·</span> Astro + React + Recharts
    </p>
  </div>
</footer>