---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '../styles/global.css';
import '../styles/shell.css';
import displayFont from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import textFont from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import Icon from '../components/Icon.astro';
import { NAV } from '../data/nav';
import { SELLERS } from '../data/catalog';
import { PROVINCES } from '../data/dataset';
import { PERIOD_LABEL, type Period } from '../data/selectors';

interface Props {
  title: string;
  description?: string;
  view: string;
}

const { title, description = 'Demo de portfolio: plataforma de ventas de un mayorista ficticio de Córdoba. Datos simulados en el navegador.', view } = Astro.props;
const periods = Object.entries(PERIOD_LABEL) as [Period, string][];
const provinces = [...PROVINCES].sort((a, b) => a.name.localeCompare(b.name, 'es'));
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
const fullTitle = `${title} · Mayorista Central (Demo)`;
---

<!doctype html>
<html lang="es-AR" data-theme="night">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090e" />
    <meta name="robots" content="noindex" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/poster.jpg" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <script is:inline>
      // Before first paint: saved view (night/paper) and showcase mode. Storage can be unavailable.
      try {
        var raw = localStorage.getItem('mc-theme');
        if (raw === 'paper' || raw === 'night') document.documentElement.dataset.theme = raw;
      } catch (e) {}
      try {
        // The showcase flag survives client-side navigation; a fresh load without ?showcase clears it.
        if (/[?&]showcase\b/.test(location.search)) sessionStorage.setItem('mc-showcase', '1');
        else if (!window.__mcBooted) sessionStorage.removeItem('mc-showcase');
        if (sessionStorage.getItem('mc-showcase') === '1') document.documentElement.classList.add('is-showcase');
      } catch (e) {}
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <aside class="sidebar" id="sidebar" transition:persist="sidebar" aria-label="Navegación principal">
      <div class="side-brand">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"
          ><rect width="32" height="32" rx="4" fill="var(--ink)"></rect><path
            d="M7 23V9h3l6 8 6-8h3v14h-3.5v-8.2L16 22l-5.5-7.2V23z"
            fill="var(--bg)"></path></svg
        >
        <span class="brand-name">Mayorista Central</span>
        <span class="demo-badge" title="Marca y datos ficticios">Demo</span>
      </div>

      <nav class="side-nav">
        <ul>
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} class="nav-link" data-nav={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  <Icon name={item.icon} />
                  <span>{item.label}</span>
                  {item.href === '/alertas' && <span class="nav-badge" data-alert-badge hidden />}
                  <kbd class="nav-kbd" aria-hidden="true">g {item.key}</kbd>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section class="side-section" aria-labelledby="saved-title">
        <div class="side-section-head">
          <h2 id="saved-title">Vistas guardadas</h2>
          <button type="button" class="mini-btn" data-action="save-view" title="Guardar la vista actual" aria-label="Guardar la vista actual">
            <Icon name="plus" size={16} />
          </button>
        </div>
        <ul class="saved-list" data-saved-views></ul>
      </section>

      <section class="side-sim" aria-labelledby="sim-title">
        <div class="sim-head">
          <h2 id="sim-title" class="live-pill" data-live-pill><span class="live-dot" aria-hidden="true"></span><span data-live-label>En vivo</span></h2>
          <span class="sim-clock num" data-sim-clock>10:30</span>
        </div>
        <p class="sim-day" data-sim-day></p>
        <div class="sim-controls">
          <button type="button" class="sim-btn" data-action="pause" aria-pressed="false" aria-label="Pausar simulación">
            <span data-icon-pause><Icon name="pause" size={16} /></span><span data-icon-play hidden><Icon name="play" size={16} /></span>
          </button>
          <div class="speed" role="radiogroup" aria-label="Velocidad de la simulación">
            {
              [1, 4, 10].map((s) => (
                <button type="button" role="radio" class="speed-btn" data-speed={s} aria-checked="false">
                  {s}x
                </button>
              ))
            }
          </div>
        </div>
        <button type="button" class="reset-btn" data-action="reset"><Icon name="reset" size={16} /> Reiniciar demo</button>
      </section>
    </aside>

    <header class="topbar" transition:persist="topbar">
      <button type="button" class="icon-btn only-mobile" data-action="menu" aria-label="Abrir menú" aria-controls="sidebar" aria-expanded="false">
        <Icon name="menu" />
      </button>
      <a href="/" class="top-brand only-mobile" aria-label="Demo · Mayorista Central, inicio">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"
          ><rect width="32" height="32" rx="4" fill="var(--ink)"></rect><path
            d="M7 23V9h3l6 8 6-8h3v14h-3.5v-8.2L16 22l-5.5-7.2V23z"
            fill="var(--bg)"></path></svg
        >
        <span class="demo-badge">Demo</span>
      </a>

      <div class="filters" role="group" aria-label="Filtros globales" data-filters>
        <div class="segmented" role="radiogroup" aria-label="Período">
          {
            periods.map(([value, label], i) => (
              <button type="button" role="radio" class="seg" data-period={value} aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                {label}
              </button>
            ))
          }
        </div>
        <label class="select">
          <span class="sr-only">Vendedor</span>
          <select data-seller>
            <option value="all">Todo el equipo</option>
            {SELLERS.map((s) => <option value={s.id}>{s.name}</option>)}
          </select>
        </label>
        <label class="select">
          <span class="sr-only">Provincia</span>
          <select data-province>
            <option value="all">Todas las provincias</option>
            {provinces.map((p) => <option value={p.id}>{p.name}</option>)}
          </select>
        </label>
      </div>

      <a href="/en-vivo" class="today" data-today title="Facturación de hoy: ver en vivo">
        <span class="today-label">Hoy</span>
        <span class="today-value num" data-today-value>$ 0</span>
      </a>

      <div class="top-actions">
        <button type="button" class="search-btn" data-action="palette" aria-label="Buscar o ejecutar una acción (Ctrl+K)">
          <Icon name="search" size={18} /><span class="search-text">Buscar</span><kbd>Ctrl K</kbd>
        </button>
        <button type="button" class="icon-btn only-mobile" data-action="filters" aria-label="Filtros" aria-expanded="false">
          <Icon name="filter" />
        </button>
        <button type="button" class="icon-btn bell" data-action="notices" aria-label="Notificaciones" aria-expanded="false" aria-controls="notices">
          <Icon name="bell" /><span class="bell-badge num" data-unread hidden>0</span>
        </button>
        <button type="button" class="icon-btn hide-mobile" data-action="theme" aria-label="Cambiar a vista papel" title="Vista noche / papel"><Icon name="theme" /></button>
        <button type="button" class="icon-btn hide-mobile" data-action="export" aria-label="Exportar imagen del gráfico activo" title="Exportar PNG"><Icon name="export" /></button>
        <button type="button" class="icon-btn hide-mobile" data-action="present" aria-label="Modo presentación" title="Presentar (pantalla completa)" aria-pressed="false"><Icon name="present" /></button>
      </div>
    </header>

    <main id="contenido" class="view" data-view={view} transition:animate="fade" tabindex="-1">
      <slot />
    </main>

    <nav class="tabbar" aria-label="Navegación rápida" transition:persist="tabbar">
      {
        NAV.filter((n) => n.mobile).map((item) => (
          <a href={item.href} class="tab" data-nav={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            <Icon name={item.icon} />
            <span>{item.label}</span>
          </a>
        ))
      }
      <button type="button" class="tab" data-action="menu" aria-controls="sidebar"><Icon name="more" /><span>Más</span></button>
    </nav>

    <div class="overlays" transition:persist="overlays">
      <section class="notices" id="notices" data-notices hidden aria-label="Notificaciones">
        <header class="notices-head">
          <h2>Notificaciones</h2>
          <button type="button" class="link-btn" data-action="read-all">Marcar todo leído</button>
        </header>
        <ol class="notices-list" data-notices-list></ol>
        <a class="notices-foot" href="/alertas">Configurar alertas</a>
      </section>
      <div class="toasts" data-toasts aria-live="polite"></div>
      <div class="scrim" data-scrim hidden></div>
    </div>
    <div class="present-hud" data-hud aria-live="polite"></div>
  </body>
</html>

<script>
  import '../scripts/app';
</script>
