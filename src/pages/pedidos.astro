---
import AppLayout from '../layouts/AppLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { MONTHS } from '../data/dataset';

const recent = MONTHS.slice(-3).reverse();
---

<AppLayout title="Pedidos" view="pedidos">
  <div class="page">
    <PageHead title="Pedidos" sub="Los de hoy entran en vivo arriba de todo. Más los de los últimos tres meses, con filtros y exportación.">
      <button type="button" class="btn" data-export-csv><Icon name="download" size={18} /> Exportar CSV</button>
    </PageHead>

    <section class="kpis" aria-label="Indicadores de pedidos">
      <div class="kpi-card"><span class="k-label">Pedidos en el filtro</span><span class="k-value" data-k="count"><span class="skeleton" style="width:90px;height:36px"></span></span></div>
      <div class="kpi-card"><span class="k-label">Monto total</span><span class="k-value" data-k="total"><span class="skeleton" style="width:140px;height:36px"></span></span></div>
      <div class="kpi-card"><span class="k-label">Ticket promedio</span><span class="k-value" data-k="avg"><span class="skeleton" style="width:100px;height:36px"></span></span></div>
      <div class="kpi-card"><span class="k-label">Hoy en vivo</span><span class="k-value k-up" data-k="today">0</span><span class="k-note" data-k="todayNote"></span></div>
    </section>

    <div class="toolbar" role="search">
      <label class="grow">
        <span class="sr-only">Buscar pedido</span>
        <input class="search-input" type="search" placeholder="Cliente, ciudad o número de pedido   ( / )" data-search autocomplete="off" />
      </label>
      <label class="field select">
        <span class="sr-only">Fecha</span>
        <select data-when>
          <option value="all">Hoy y últimos 3 meses</option>
          <option value="today">Solo hoy</option>
          {recent.map((m) => <option value={String(m.index)}>{m.label}</option>)}
        </select>
      </label>
      <label class="field select">
        <span class="sr-only">Estado</span>
        <select data-status>
          <option value="all">Todos los estados</option>
          <option value="Nuevo">Nuevos (hoy)</option>
          <option value="Preparando">Preparando</option>
          <option value="En camino">En camino</option>
          <option value="Entregado">Entregados</option>
        </select>
      </label>
      <label class="field select">
        <span class="sr-only">Monto</span>
        <select data-amount>
          <option value="0">Cualquier monto</option>
          <option value="200000">Más de $ 200.000</option>
          <option value="400000">Más de $ 400.000</option>
          <option value="800000">Más de $ 800.000</option>
        </select>
      </label>
      <span class="tag tag--hot" data-client-filter hidden></span>
    </div>
    <div data-order-table><div class="table-scroll"><table class="grid-table"><tbody>{Array.from({ length: 10 }).map(() => <tr>{Array.from({ length: 7 }).map(() => <td><span class="skeleton" /></td>)}</tr>)}</tbody></table></div></div>
  </div>
</AppLayout>

<style>
  [data-order-table] :global(.c-sub) {
    display: block;
    font-size: 13px;
    color: var(--muted);
  }

  [data-client-filter] {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    min-height: 40px;
    padding: 0 10px;
  }

  [data-client-filter] :global(button) {
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    font-size: 18px;
  }

  @media (max-width: 900px) {
    [data-order-table] :global(.wide) {
      display: none;
    }
  }
</style>
