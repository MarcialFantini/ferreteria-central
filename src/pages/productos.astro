---
import AppLayout from '../layouts/AppLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { CATEGORIES } from '../data/catalog';
---

<AppLayout title="Productos" view="productos">
  <div class="page">
    <PageHead title="Productos" sub="80 productos en 8 categorías. Qué vende, cuánto deja y qué concentra la facturación (curva ABC).">
      <button type="button" class="btn" data-export-csv><Icon name="download" size={18} /> Exportar CSV</button>
    </PageHead>

    <section class="kpis" aria-label="Indicadores del catálogo">
      <div class="kpi-card"><span class="k-label">Facturación del período</span><span class="k-value" data-k="revenue"><span class="skeleton" style="width:140px;height:36px"></span></span></div>
      <div class="kpi-card"><span class="k-label">Margen bruto</span><span class="k-value" data-k="margin"><span class="skeleton" style="width:120px;height:36px"></span></span><span class="k-note" data-k="marginPct"></span></div>
      <div class="kpi-card"><span class="k-label">Productos clase A</span><span class="k-value k-up" data-k="a"><span class="skeleton" style="width:40px;height:36px"></span></span><span class="k-note">concentran el 80 % de la facturación</span></div>
      <div class="kpi-card"><span class="k-label">Bultos vendidos</span><span class="k-value" data-k="units"><span class="skeleton" style="width:100px;height:36px"></span></span></div>
    </section>

    <section class="panel" style="margin-bottom:20px">
      <div class="pareto-head">
        <h2 class="panel-title">Curva ABC (Pareto)</h2>
        <p class="legend"><span class="sw"></span>A <span class="sw sw--b"></span>B <span class="sw sw--c"></span>C <span class="line-sw"></span>% acumulado</p>
      </div>
      <div class="pareto" data-pareto><span class="skeleton" style="height:100%"></span></div>
    </section>

    <div class="toolbar" role="search">
      <label class="grow">
        <span class="sr-only">Buscar producto</span>
        <input class="search-input" type="search" placeholder="Buscar producto   ( / )" data-search autocomplete="off" />
      </label>
      <label class="field select">
        <span class="sr-only">Categoría</span>
        <select data-category>
          <option value="all">Todas las categorías</option>
          {CATEGORIES.map((c) => <option value={c}>{c}</option>)}
        </select>
      </label>
      <label class="field select">
        <span class="sr-only">Clase ABC</span>
        <select data-abc>
          <option value="all">A, B y C</option>
          <option value="A">Clase A</option>
          <option value="B">Clase B</option>
          <option value="C">Clase C</option>
        </select>
      </label>
    </div>
    <div data-product-table><div class="table-scroll"><table class="grid-table"><tbody>{Array.from({ length: 8 }).map(() => <tr>{Array.from({ length: 6 }).map(() => <td><span class="skeleton" /></td>)}</tr>)}</tbody></table></div></div>
  </div>
</AppLayout>

<style>
  .pareto-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }

  .legend {
    display: flex;
    gap: 6px;
    align-items: center;
    color: var(--muted);
    font-size: 14px;
  }

  .sw {
    width: 12px;
    height: 12px;
    background: var(--accent);
    display: inline-block;
    margin-left: 8px;
  }

  .sw--b {
    background: var(--ink);
    opacity: 0.55;
  }

  .sw--c {
    background: var(--surface-2);
  }

  .line-sw {
    width: 18px;
    height: 2px;
    background: var(--ink);
    display: inline-block;
    margin-left: 8px;
  }

  .pareto {
    height: 280px;
  }

  .pareto :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .pareto :global(.pa-bar) {
    fill: var(--surface-2);
    cursor: pointer;
  }

  .pareto :global(.pa-bar.is-a) {
    fill: var(--accent);
  }

  .pareto :global(.pa-bar.is-b) {
    fill: var(--ink);
    opacity: 0.55;
  }

  .pareto :global(.pa-bar:hover) {
    opacity: 1;
    fill: var(--ink);
  }

  .pareto :global(.pa-line) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
  }

  .pareto :global(.pa-guide) {
    stroke: var(--line);
    stroke-dasharray: 3 4;
  }

  .pareto :global(.pa-label) {
    fill: var(--muted);
    font: 700 15px var(--font-display);
  }

  [data-product-table] :global(.c-sub) {
    display: block;
    font-size: 13px;
    color: var(--muted);
  }

  [data-product-table] :global(.mini-spark) {
    width: 96px;
    height: 28px;
  }

  @media (max-width: 900px) {
    [data-product-table] :global(.wide) {
      display: none;
    }

    .pareto {
      height: 200px;
    }
  }
</style>
