---
import Layout from '../layouts/Layout.astro';
import Dashboard from '../components/Dashboard';

const title = 'Ferretería Central — Dashboard de ventas';
const description = 'Dashboard de ventas para Ferretería Central: facturación mensual, ticket promedio, top productos por categoría y variación anual.';
---

<Layout title={title} description={description}>
  <section class="mb-8 sm:mb-10" aria-labelledby="hero-title">
    <p class="text-xs font-medium uppercase tracking-widest text-[var(--color-accent)]">
      Análisis de ventas
    </p>
    <h1
      id="hero-title"
      class="mt-2 text-3xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-4xl"
    >
      Dashboard de ventas
    </h1>
    <p class="mt-3 max-w-2xl text-base text-[var(--color-ink-2)]">
      Visualizá el desempeño de la ferretería mes a mes: facturación, ticket
      promedio, variación anual y los productos que más ingresos generan.
      Filtrá por período para ver el detalle.
    </p>
  </section>

  {/* El Dashboard es la única isla React del proyecto (más sus subcomponentes).
      Se monta con `client:visible` para no afectar el LCP del hero
      (T10.18 — Performance). */}
  <Dashboard client:visible />
</Layout>